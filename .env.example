# ---------------------------------------------------------------------------
# Backend API base URL
# ---------------------------------------------------------------------------
# Local development points to the local backend; production uses the public API.
# NEXT_PUBLIC_* variables are exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production: https://api.pnhd.ru
# Stage: https://api-stage.pnhd.ru
# Legacy (until DNS cutover): https://pnhdstudioapi.ru

# ---------------------------------------------------------------------------
# Constructor (/constructor)
# ---------------------------------------------------------------------------
# Catalog API for the constructor (defaults to https://api.pnhd.ru)
NEXT_PUBLIC_PNHD_API_URL=https://api.pnhd.ru
# Yandex Metrica counter id; empty — the site counter 86217584 (src/components/site/analytics.ts)
NEXT_PUBLIC_YM_COUNTER_ID=
# DTF price table: tiered (default) or site
NEXT_PUBLIC_PRICE_SOURCE=
# Where constructor orders go. Nothing set — the order is written to the server log.
# Bitrix24 incoming webhook with CRM rights: https://<portal>.bitrix24.ru/rest/<id>/<key>/
# Pipeline and deal fields are fixed in src/app/api/orders/_lib/bitrix.ts (CRM schema)
ORDER_BITRIX_WEBHOOK=
# Telegram fallback when Bitrix24 is not set or unavailable
ORDER_TELEGRAM_BOT_TOKEN=
ORDER_TELEGRAM_CHAT_ID=
# Password for the order log export /api/orders/ledger (Excel, HTTP Basic, any user name). Empty — no export
ORDER_LEDGER_TOKEN=
# Folder for orders before delivery (default data/orders); must survive restarts (Docker volume)
ORDER_STORE_DIR=
